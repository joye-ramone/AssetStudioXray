<Project Sdk="Microsoft.NET.Sdk">

    <!-- Raw Unity dumps for the OGSR X-Ray converters (weapons, hands, items with their animations). See Program.cs for the commands. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>AssetStudioXray</AssemblyName>
        <Version>0.1.0.0</Version>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>AnyCPU;x64</Platforms>
        <Nullable>disable</Nullable>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AssetStudioUtility\AssetStudioUtility.csproj" />
        <ProjectReference Include="..\AssetStudio\AssetStudio.csproj" />
    </ItemGroup>

    <!-- native libraries: the texture decoder and fmod (AudioClip -> wav); no FBX, no ooz -->
    <Target Name="CopyTextureDecoder" AfterTargets="AfterBuild">
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Texture2DDecoderNative\bin\x64\$(Configuration)\Texture2DDecoderNative.dll" DestinationFolder="$(TargetDir)runtimes\win-x64\native" ContinueOnError="false" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\AssetStudioCLI\Libraries\win-x64\fmod.dll" DestinationFolder="$(TargetDir)runtimes\win-x64\native" ContinueOnError="false" />
    </Target>

</Project>
