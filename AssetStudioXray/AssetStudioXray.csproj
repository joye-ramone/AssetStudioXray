<Project Sdk="Microsoft.NET.Sdk">

    <!-- Raw Unity dumps for the OGSR X-Ray converters (weapons, hands, items with their animations). See Program.cs for the commands. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>AssetStudioXray</AssemblyName>
        <Version>0.1.0.0</Version>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>AnyCPU;x64</Platforms>
        <Nullable>disable</Nullable>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AssetStudioUtility\AssetStudioUtility.csproj" />
        <ProjectReference Include="..\AssetStudio\AssetStudio.csproj" />
    </ItemGroup>

    <!-- native libraries: fmod (AudioClip -> wav) from Libraries; the texture decoder comes with its NuGet package (AssetStudioUtility) -->
    <ItemGroup>
        <None Include="Libraries\win-x64\fmod.dll" Link="runtimes\win-x64\native\fmod.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
